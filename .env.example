# .env.example
# CAVE (KV) - Environment Configuration
CAVE_HOST=0.0.0.0
CAVE_PORT=8443
CAVE_USE_HTTPS=true
CAVE_SECRET_KEY=change-this-to-a-random-64-char-hex-string-in-production
CAVE_PAIRING_PIN=482910

# Speech Recognition ("vosk" for offline local PCM, or "browser_only")
CAVE_ASR_PROVIDER=vosk
CAVE_VOSK_MODEL_PATH=models/vosk-model-small-pt-0.3

# Optional AI Conversational Assistant ("none", "ollama", or "openai")
CAVE_AI_PROVIDER=none
CAVE_AI_BASE_URL=http://127.0.0.1:11434/v1
CAVE_AI_MODEL=llama3.2
CAVE_AI_API_KEY=